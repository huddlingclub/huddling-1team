# 실제 값을 이 파일에 넣지 마세요. .env.local에 복사해 입력하세요.
# Supabase 프로젝트 URL과 서버 전용 비밀 키
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 팀장 조 선택에 사용할 행사 토큰 (setup-event.mjs가 로컬에 생성)
HUDDLING_EVENT_TOKEN=
# 서버 전용 OpenAI 키와 모델. 유료 호출은 별도 승인 후 활성화하세요.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=
# 실제 유료 호출 승인 후에만 true로 설정
AI_ALLOW_PAID=
# 배포 주소. 비워두면 현재 요청의 주소를 사용합니다.
NEXT_PUBLIC_APP_URL=
